# Variables d'environnement du projet, lues par docker compose
# (--env-file .env) et, à partir de T3, par l'application (app/core/config.py).
# Copier ce fichier en .env et renseigner des valeurs réelles.
# Toutes les variables listées ici sont obligatoires : le compose refuse de
# démarrer si l'une d'elles est absente ("VAR manquant").
# Complété par les tâches suivantes (T3, T6, T8) au fur et à mesure des besoins.

# Nom de domaine public de l'API, utilisé par Traefik pour le routage HTTPS
# (label traefik.http.routers.api.rule=Host(`${DOMAIN}`)). Obligatoire.
DOMAIN=bl.example.invalid

# Adresse e-mail transmise à Let's Encrypt par le résolveur ACME de Traefik
# (obligatoire pour toute demande de certificat). Obligatoire.
ACME_EMAIL=admin@example.invalid

# Identifiants de la base PostgreSQL (service postgres du compose). Obligatoire.
POSTGRES_USER=bl
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bl

# Répertoire hôte contenant les originaux (PDF de factures, photos de BL),
# monté dans le conteneur api sur /srv/docs. Obligatoire.
DOCS_HOST_DIR=/srv/habitat-reno/docs

# URL de connexion async à PostgreSQL (app.core.config.Settings), lue par
# l'application au démarrage. Obligatoire.
DATABASE_URL=postgresql+asyncpg://bl:change-me@127.0.0.1:5432/bl

# Répertoire des originaux vu par l'application (app.core.config.Settings).
# En conteneur, correspond au point de montage de DOCS_HOST_DIR (/srv/docs).
# Obligatoire.
DOCS_DIR=/srv/docs

# URL de connexion à la base de test, lue uniquement par tests/conftest.py
# (jamais par l'application). Obligatoire pour lancer la suite de tests.
TEST_DATABASE_URL=postgresql+asyncpg://bl:change-me@127.0.0.1:5432/bl_test

# Token du bot Telegram (app.core.config.Settings, en SecretStr : jamais
# affiché dans un log, une exception ou un repr). Utilisé par
# app/modules/messaging/telegram.py pour construire les URL de l'API Bot
# Telegram (https://api.telegram.org/bot<token>/...). Obligatoire.
TELEGRAM_BOT_TOKEN=000000:change-me

# Secret partagé avec Telegram lors du `setWebhook` (paramètre
# `secret_token`), vérifié sur chaque appel entrant via l'en-tête
# `X-Telegram-Bot-Api-Secret-Token` (app.core.config.Settings, en SecretStr).
# Obligatoire.
TELEGRAM_WEBHOOK_SECRET=change-me

# --- Sauvegarde / restauration (deploy/backup.sh, deploy/restore.sh) -------
# Ces variables ne sont lues que par les scripts de deploy/, jamais par
# docker compose ni par l'application.

# Dépôt restic. Soit un chemin local commençant par "/" (ex. pour un test),
# soit une URL de dépôt distant (ex. Object Storage OVH, compatible S3 :
# "s3:https://s3.gra.io.cloud.ovh.net/mon-bucket/habitat-reno"). Obligatoire.
RESTIC_REPOSITORY=s3:https://s3.gra.io.cloud.ovh.net/change-me/habitat-reno

# Mot de passe de chiffrement du dépôt restic, généré une fois (par exemple
# `openssl rand -base64 32`) et conservé hors du dépôt git (voir
# deploy/RESTAURATION.md, section rotation du mot de passe). Obligatoire.
RESTIC_PASSWORD=change-me

# Identifiants OVH Object Storage (compatible S3), utilisés par restic
# uniquement quand RESTIC_REPOSITORY désigne un dépôt distant (préfixe
# "s3:") : ignorés (et non requis) pour un dépôt local. Obligatoires en
# production.
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me
